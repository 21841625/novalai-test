# API Provider Configuration
# Set AUTONOVEL_API_PROVIDER to "anthropic" or "deepseek"
AUTONOVEL_API_PROVIDER=deepseek

# DeepSeek API configuration (when using deepseek)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
AUTONOVEL_API_BASE_URL=https://api.deepseek.com/v1
AUTONOVEL_WRITER_MODEL=deepseek-v4-flash
AUTONOVEL_JUDGE_MODEL=deepseek-v4-flash
AUTONOVEL_REVIEW_MODEL=deepseek-v4-pro

# Anthropic API configuration (when using anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# AUTONOVEL_API_BASE_URL=https://api.anthropic.com
# AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6
# AUTONOVEL_JUDGE_MODEL=claude-sonnet-4-6
# AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# fal.ai key for image generation (Nano Banana 2)
FAL_KEY=your-fal-api-key-here

# ElevenLabs API key for audiobook generation
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
